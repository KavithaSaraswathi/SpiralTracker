# Spring Boot Backend Environment Configuration
# Copy this file to .env or set environment variables in your terminal

# MySQL Database URL
DB_URL=jdbc:mysql://localhost:3306/spiraltrack_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Credentials
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# Set to true if you want to preload development sample data on first run
SEED_DATA=false
