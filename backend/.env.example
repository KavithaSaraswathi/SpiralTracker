# Spring Boot Backend Environment Configuration
# Use these values in your terminal or IDE environment configuration.
# Spring Boot does not automatically load .env files.

# PostgreSQL connection settings (local defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spiraltrack_db
DB_SSLMODE=disable

# Set these to the credentials for your local PostgreSQL role
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# Optional: override the host/port/name URL assembled above
# DB_URL=jdbc:postgresql://localhost:5432/spiraltrack_db

# Set to true if you want to preload development sample data on first run
SEED_DATA=false
